# Public client configuration only. Copy to .env.local and use your project values.
# Never add a secret/service-role key, database password, user password or session token.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_replace_with_your_publishable_key
# Optional Expo Go/web email redirect override: actual owned, hosted HTTPS landing page.
# Blank uses Supabase Site URL (configure it). Mobile uses rideapp://auth/callback.
EXPO_PUBLIC_AUTH_EMAIL_REDIRECT_URL=
